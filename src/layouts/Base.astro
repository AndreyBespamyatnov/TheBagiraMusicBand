---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict, htmlLang, localePath, type Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  page: 'home' | 'disco' | '404';
  title: string;
  description: string;
  path: string;
}

const { lang, page, title, description, path } = Astro.props;
const t = getDict(lang);
const canonical = new URL(path, Astro.site);
const ruUrl = new URL(localePath('ru', page === 'disco' ? '/discography/' : '/'), Astro.site);
const enUrl = new URL(localePath('en', page === 'disco' ? '/discography/' : '/'), Astro.site);
const og = new URL('/images/og.jpg', Astro.site);
const headerPage = page === 'disco' ? 'disco' : 'home';
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="view-transition" content="same-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="ru" href={ruUrl.href} />
    <link rel="alternate" hreflang="en" href={enUrl.href} />
    <link rel="alternate" hreflang="x-default" href={ruUrl.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={og.href} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.href} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    <script is:inline>
      (function () {
        try {
          var key = 'bagira-lang';
          var path = location.pathname;
          if (path === '/' || path === '/discography/' || path === '/en/' || path === '/en/discography/') {
            document.cookie = key + '=' + (path.indexOf('/en') === 0 ? 'en' : 'ru') + '; Path=/; Max-Age=31536000; SameSite=Lax';
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MusicGroup',
      name: 'BAGIRA',
      alternateName: ['Багира', 'Bagira'],
      url: 'https://bagiraofficial.ru/',
      foundingDate: '2011',
      foundingLocation: { '@type': 'City', name: 'Kazan' },
      genre: ['Groove metal', 'Modern metal', 'Melodic death metal'],
      email: 'bagira-metal@mail.ru',
      telephone: '+79047638356',
      sameAs: [
        'https://vk.com/bagirametal',
        'https://www.youtube.com/c/bagiraofficial',
        'https://open.spotify.com/artist/3j1EDcvcTIShQ7gL1NOIqr',
        'https://www.instagram.com/bagiraofficial',
        'https://band.link/bagira',
      ],
    })} />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <Header lang={lang} page={headerPage} />
    <slot />
    <Footer lang={lang} />
    <script src="../scripts/ui.ts"></script>
    {page === 'home' && (
      <script is:inline type="speculationrules" set:html={JSON.stringify({
        prerender: [{ where: { href_matches: ['/discography/', '/en/', '/en/discography/'] }, eagerness: 'moderate' }],
      })} />
    )}
  </body>
</html>
