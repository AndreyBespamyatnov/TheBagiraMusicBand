{
  "trailingSlash": "always",
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "routes": [
    { "route": "/index.html", "redirect": "/", "statusCode": 301 },
    { "route": "/discography.html", "redirect": "/discography/", "statusCode": 301 },
    { "route": "/en/index.html", "redirect": "/en/", "statusCode": 301 },
    { "route": "/en/discography.html", "redirect": "/en/discography/", "statusCode": 301 }
  ]
}
